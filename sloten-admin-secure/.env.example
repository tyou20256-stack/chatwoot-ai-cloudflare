# Copy to .dev.vars (for `wrangler pages dev`) or set via Cloudflare dashboard.
# Do NOT commit the real values.

# Public URL of the deployed AI Gateway Worker (from `wrangler deploy` output).
AI_GATEWAY_URL=https://chatwoot-ai-gateway.your-account.workers.dev

# Same value as the Worker's ADMIN_API_TOKEN secret. Keep secret.
ADMIN_API_TOKEN=paste_wrangler_secret_value_here
