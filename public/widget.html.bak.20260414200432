      <button class="menu-btn" onclick="q('出金方法を教えて')"><span class="ico green"><svg viewBox="0 0 24 24" fill="none" stroke="#27ae60" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h20v13H2z"/><path d="M16 14a2 2 0 11-4 0 2 2 0 014 0z"/><path d="M2 7l2-4h16l2 4"/></svg></span>出金方法</button>
      <button class="menu-btn" onclick="q('ボーナスコードの一覧')"><span class="ico gold"><svg viewBox="0 0 24 24" fill="none" stroke="#d4a017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg></span>ボーナス</button>
      <button class="menu-btn" onclick="q('パチスロはある？')"><span class="ico red"><svg viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></span>パチスロ</button>
      <button class="menu-btn" onclick="q('パスワード忘れた')"><span class="ico blue"><svg viewBox="0 0 24 24" fill="none" stroke="#2f6e9e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg></span>パスワード</button>
      <button class="menu-btn" onclick="q('ゲームプロバイダーは？')"><span class="ico green"><svg viewBox="0 0 24 24" fill="none" stroke="#27ae60" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h4m-2-2v4"/><circle cx="15" cy="11" r="1"/><circle cx="18" cy="13" r="1"/><rect x="2" y="6" width="20" height="12" rx="3"/></svg></span>ゲーム</button>
    </div>
    <button class="menu-btn-full" onclick="q('人と話したい')">💬 オペレーターに直接相談する</button>
  </div>

  <div class="input-area">
    <!-- 画像プレビューバー -->
    <div class="image-preview-bar" id="imagePreviewBar">
      <img class="image-preview-thumb" id="imagePreviewThumb" src="" alt="preview">
      <div class="image-preview-info">
        <div class="image-preview-name" id="imagePreviewName">image.jpg</div>
        <div class="image-preview-size" id="imagePreviewSize">0 KB</div>
