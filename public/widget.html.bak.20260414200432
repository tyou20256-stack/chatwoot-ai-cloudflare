<script>
const API='https://chatwoot-ai-gateway.koni-tanaka.workers.dev';
const msgs=document.getElementById('messages');
let history=[];
const phrases=['確認中','検索中','回答を準備中'];
const imageAnalysisPhrases=['画像を分析中','スクリーンショットを確認中','内容を読み取り中'];

// --- 画像関連の状態管理 ---
let pendingImage = null; // { base64, mimeType, name, size, dataUrl }
const MAX_IMAGE_SIZE = 5 * 1024 * 1024; // 5MB
const MAX_DIMENSION = 1024; // リサイズ上限px

// 時間帯挨拶
const h=new Date().getHours();
const greet=h>=5&&h<12?'おはようございます':h>=17?'こんばんは':'こんにちは';
document.getElementById('greetText').textContent=(h>=17?'こんばんは':greet)+'、スロット天国サポートです';

// ============================================
// 画像処理
// ============================================

/**
 * ファイル選択ダイアログを開く
 */
function triggerImageInput() {
  document.getElementById('imageInput').click();
}

/**
 * ファイル選択イベントハンドラ
 */
document.getElementById('imageInput').addEventListener('change', async function(e) {
  const file = e.target.files[0];
  if (!file) return;

  // ファイルタイプチェック
  const allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
  if (!allowed.includes(file.type)) {
    alert('JPEG, PNG, GIF, WebP形式の画像のみ対応しています。');
    this.value = '';
    return;
  }

  // サイズチェック
  if (file.size > MAX_IMAGE_SIZE) {
    const sizeMB = (file.size / (1024 * 1024)).toFixed(1);
    alert(`画像サイズが大きすぎます（${sizeMB}MB）。5MB以下の画像を選択してください。`);
    this.value = '';
    return;
  }

  try {
    // リサイズ + Base64変換
    const result = await processImage(file);
    pendingImage = {
      base64: result.base64,
      mimeType: result.mimeType,
      name: file.name,
      size: result.sizeBytes,
      dataUrl: result.dataUrl,
    };

    // プレビュー表示
    showImagePreview(pendingImage);
  } catch (err) {
    console.error('画像処理エラー:', err);
    alert('画像の読み込みに失敗しました。もう一度お試しください。');
  }

  // inputリセット（同じファイルを再選択可能に）
  this.value = '';
});

/**
 * 画像を読み込み、必要に応じてリサイズし、Base64に変換
 * @param {File} file
 * @returns {Promise<{base64: string, mimeType: string, dataUrl: string, sizeBytes: number}>}
 */
function processImage(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = function() {
        // リサイズ判定
        let width = img.width;
        let height = img.height;
        let needsResize = false;

        if (width > MAX_DIMENSION || height > MAX_DIMENSION) {
          needsResize = true;
          if (width > height) {
            height = Math.round(height * (MAX_DIMENSION / width));
            width = MAX_DIMENSION;
          } else {
            width = Math.round(width * (MAX_DIMENSION / height));
            height = MAX_DIMENSION;
          }
        }

        // Canvas描画（リサイズ or そのまま）
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        // JPEG出力（品質0.85でファイルサイズ抑制）
        const outputMime = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
        const quality = outputMime === 'image/jpeg' ? 0.85 : undefined;
        const dataUrl = canvas.toDataURL(outputMime, quality);

        // Base64部分を抽出
        const base64 = dataUrl.split(',')[1];
        const sizeBytes = Math.ceil(base64.length * 3 / 4);

        resolve({
          base64,
          mimeType: outputMime,
          dataUrl,
          sizeBytes,
        });
      };
      img.onerror = () => reject(new Error('画像の読み込みに失敗'));
      img.src = e.target.result;
    };
    reader.onerror = () => reject(new Error('ファイルの読み込みに失敗'));
    reader.readAsDataURL(file);
  });
}

/**
 * プレビュー表示
 */
function showImagePreview(imageData) {
  const bar = document.getElementById('imagePreviewBar');
  const thumb = document.getElementById('imagePreviewThumb');
  const name = document.getElementById('imagePreviewName');
  const size = document.getElementById('imagePreviewSize');
  const btn = document.getElementById('attachBtn');

  thumb.src = imageData.dataUrl;
  name.textContent = imageData.name;
  size.textContent = formatFileSize(imageData.size);
  bar.classList.add('active');
  btn.classList.add('has-image');
}

/**
 * 画像を削除
 */
function removeImage() {
  pendingImage = null;
  const bar = document.getElementById('imagePreviewBar');
  const btn = document.getElementById('attachBtn');
  bar.classList.remove('active');
  btn.classList.remove('has-image');
}

/**
 * ファイルサイズのフォーマット
 */
function formatFileSize(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

// ============================================
// メッセージ表示
// ============================================

function addMsg(text, type, meta) {
  const d = document.createElement('div');
  d.className = 'msg ' + type;
  const b = document.createElement('div');
  b.className = 'bubble';
  b.textContent = text;
  d.appendChild(b);
  const t = document.createElement('div');
  t.className = 'msg-time';
  t.textContent = new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
  d.appendChild(t);
  if (meta) {
    const m = document.createElement('div');
    m.className = 'msg-meta';
    m.textContent = meta;
    d.appendChild(m);
  }
  msgs.appendChild(d);
  msgs.scrollTop = msgs.scrollHeight;
}

/**
 * 画像付きメッセージを表示
 */
function addImageMsg(imageDataUrl, text, type) {
  const d = document.createElement('div');
  d.className = 'msg ' + type;

  // 画像バブル
  const imgBubble = document.createElement('div');
  imgBubble.className = 'bubble-image';
  const img = document.createElement('img');
  img.src = imageDataUrl;
  img.alt = 'ユーザー送信画像';
  imgBubble.appendChild(img);

  // テキストキャプション（あれば）
  if (text) {
    const caption = document.createElement('div');
    caption.className = 'bubble-image-caption';
    caption.textContent = text;
    imgBubble.appendChild(caption);
  }

  d.appendChild(imgBubble);

  const t = document.createElement('div');
  t.className = 'msg-time';
  t.textContent = new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
  d.appendChild(t);

  msgs.appendChild(d);
  msgs.scrollTop = msgs.scrollHeight;
}

function showTyping(isImageAnalysis) {
  const activePhrases = isImageAnalysis ? imageAnalysisPhrases : phrases;
  const d = document.createElement('div');
  d.className = 'msg bot';
  d.id = 'typing';
  d.innerHTML = '<div class="typing"><div class="typing-dots"><span></span><span></span><span></span></div><div class="typing-text">' + activePhrases[0] + '...</div></div>';
  msgs.appendChild(d);
  msgs.scrollTop = msgs.scrollHeight;
  let i = 0;
  d._iv = setInterval(() => {
    i = (i + 1) % activePhrases.length;
    const t = d.querySelector('.typing-text');
    if (t) t.textContent = activePhrases[i] + '...';
  }, 1200);
}
function hideTyping() {
  const d = document.getElementById('typing');
  if (d) { clearInterval(d._iv); d.remove(); }
}

// ============================================
// 送信処理
// ============================================

async function send() {
  const input = document.getElementById('input');
  const text = input.value.trim();
  const hasText = text.length > 0;
  const hasImage = pendingImage !== null;

  // テキストも画像もない場合は何もしない
  if (!hasText && !hasImage) return;

  // UI表示
  if (hasImage && hasText) {
    // 画像+テキスト
    addImageMsg(pendingImage.dataUrl, text, 'user');
  } else if (hasImage) {
    // 画像のみ
    addImageMsg(pendingImage.dataUrl, null, 'user');
  } else {
    // テキストのみ
    addMsg(text, 'user');
  }

  input.value = '';

  // 送信ペイロード構築
  const payload = {
    conversation_history: history.slice(-10),
  };

  if (hasText) {
    payload.message = text;
    history.push({ role: 'user', content: text });
  }

  if (hasImage) {
    payload.image = pendingImage.base64;
    payload.image_mime_type = pendingImage.mimeType;
    if (!hasText) {
      payload.message = ''; // テキスト無し画像送信
      history.push({ role: 'user', content: '[画像を送信しました]' });
    }
  }

  // 画像プレビューをクリア
  const sentImage = hasImage;
  removeImage();

  showTyping(sentImage);

  try {
    const r = await fetch(API + '/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const d = await r.json();
    hideTyping();

    const reply = d.reply || d.error || 'エラーが発生しました';
    const ms = d.responseTimeMs ? (d.responseTimeMs / 1000).toFixed(1) + '秒' : '';
    const modelInfo = d.imageAnalyzed ? '📷 画像分析' : '';
    const metaText = [modelInfo, ms].filter(Boolean).join(' · ');
    addMsg(reply, 'bot', metaText);
    history.push({ role: 'assistant', content: reply });

    // 回答後クイックリプライ
    const qr = document.createElement('div');
    qr.className = 'msg bot';
    qr.innerHTML = '<div class="quick-replies"><button class="qr-btn" onclick="showMenu()">他の質問</button></div>';
    msgs.appendChild(qr);
    msgs.scrollTop = msgs.scrollHeight;
  } catch (e) {
    hideTyping();
    addMsg('接続エラーです。しばらくしてから再度お試しください。', 'bot');
  }
}

function q(text) {
  document.getElementById('input').value = text;
  send();
}

function showMenu() {
  const d = document.createElement('div');
  d.className = 'msg bot';
  d.innerHTML = `<div class="bubble">他にご質問はございますか？</div>
  <div class="quick-replies" style="margin-top:6px">
    <button class="qr-btn" onclick="q('入金方法を教えて')">入金</button>
    <button class="qr-btn" onclick="q('出金方法を教えて')">出金</button>
    <button class="qr-btn" onclick="q('ボーナスコードの一覧')">ボーナス</button>
    <button class="qr-btn" onclick="q('パチスロはある？')">パチスロ</button>
    <button class="qr-btn" onclick="q('人と話したい')">オペレーター</button>
  </div>`;
  msgs.appendChild(d);
  msgs.scrollTop = msgs.scrollHeight;
}

document.getElementById('input').addEventListener('keypress', e => {
  if (e.key === 'Enter') send();
});

// ドラッグ&ドロップ対応
const messagesArea = document.getElementById('messages');
messagesArea.addEventListener('dragover', e => {
  e.preventDefault();
  e.stopPropagation();
  messagesArea.style.background = '#e8f4fd';
});
messagesArea.addEventListener('dragleave', e => {
  e.preventDefault();
  messagesArea.style.background = '';
});
messagesArea.addEventListener('drop', async e => {
  e.preventDefault();
  e.stopPropagation();
  messagesArea.style.background = '';
  const file = e.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) {
    // 疑似的にfileInputに設定
    const dt = new DataTransfer();
    dt.items.add(file);
    const imageInput = document.getElementById('imageInput');
    imageInput.files = dt.files;
    imageInput.dispatchEvent(new Event('change'));
  }
});

// モバイル: ペースト画像対応
document.getElementById('input').addEventListener('paste', async e => {
  const items = e.clipboardData?.items;
  if (!items) return;
  for (const item of items) {
    if (item.type.startsWith('image/')) {
      e.preventDefault();
      const file = item.getAsFile();
      if (file) {
        const dt = new DataTransfer();
        dt.items.add(file);
        const imageInput = document.getElementById('imageInput');
        imageInput.files = dt.files;
        imageInput.dispatchEvent(new Event('change'));
      }
      break;
    }
  }
});
</script>
